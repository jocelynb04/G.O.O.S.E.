"""Level-2 geometry: Python port of GeometryBase.m and TtpaGeom.m (IHW3).

This is a FAITHFUL port: same property names, same equations, same inputs. It is
meant to reproduce the homework check table first. The seaplane changes (hull,
floats, motor pods, cruciform tail, cabin from the RFP) come after that.

Design carried over from MATLAB:
  * S_ref is the ONLY mutable value (plain attribute, NaN until the loop sets it).
  * Everything else is a @property, recomputed on every read: nothing is cached,
    and assigning to one raises AttributeError (MATLAB: assigning to a Dependent
    property errors).
  * Propulsion is INJECTED and read at call time, so a changed P_SL shows up on
    the next read.
"""
from abc import ABC, abstractmethod
from math import atan, degrees, pi, sqrt  # noqa: F401  (atan/degrees kept for sweep helpers)


# ---------------------------------------------------------------------------
# GeometryBase: the contract plus the planform identities every level shares.
# Must come BEFORE the class that inherits from it.
# ---------------------------------------------------------------------------
class GeometryBase(ABC):
    @abstractmethod
    def get_S_ref(self):
        """Wing reference area [ft^2]."""

    @abstractmethod
    def get_S_wet(self, W_TO=None):
        """Total aircraft wetted area [ft^2]. W_TO is accepted so a Level-1 model
        (a regression on gross weight) can meet the same contract."""

    @staticmethod
    def compute_root_chord(S_ref, b, lam):
        """Root chord [ft]. [Raymer 7th ed. Eq. 7.6]"""
        if not (S_ref > 0 and b > 0 and lam >= 0):
            raise ValueError(f"compute_root_chord: bad inputs S_ref={S_ref}, b={b}, lambda={lam}")
        return 2 * S_ref / (b * (1 + lam))

    @staticmethod
    def compute_tip_chord(c_root, lam):
        """Tip chord [ft]. [Raymer 7th ed. Eq. 7.7]"""
        if not (c_root > 0 and lam >= 0):
            raise ValueError(f"compute_tip_chord: bad inputs c_root={c_root}, lambda={lam}")
        return lam * c_root

    @staticmethod
    def compute_mac(c_root, lam):
        """Mean aerodynamic chord [ft]. [Raymer 7th ed. Eq. 7.8]"""
        if not (c_root > 0 and lam >= 0):
            raise ValueError(f"compute_mac: bad inputs c_root={c_root}, lambda={lam}")
        return (2 / 3) * c_root * (1 + lam + lam ** 2) / (1 + lam)

    @staticmethod
    def compute_span(AR, S_ref):
        """Span [ft] from aspect ratio and reference area (AR = b^2 / S_ref)."""
        if not (AR > 0 and S_ref > 0):        # also rejects NaN, like mustBePositive
            raise ValueError(f"compute_span: AR and S_ref must be positive, got AR={AR}, S_ref={S_ref}")
        return sqrt(AR * S_ref)


# ---------------------------------------------------------------------------
# TtpaGeom (faithful port)
# ---------------------------------------------------------------------------
class TtpaGeom(GeometryBase):
    def __init__(self, J, prop):
        """J is the already-loaded (underscore-stripped) JSON dict; prop is injected."""
        self.prop = prop                      # injected: nacelle length follows P_SL
        self.S_ref = float("nan")             # THE design variable: the loop writes it

        G = J["geometry"]

        # --- wing shape ---
        self.AR = G["AR"]
        self.taper = G["taper_ratio"]
        self.sweep_qc_deg = G["sweep_quarter_chord_deg"]
        self.tc_root = G["thickness_ratio_root"]
        self.tc_tip = G["thickness_ratio_tip"]
        self.twist_deg = G["twist_deg"]
        self.incidence_deg = G["incidence_deg"]
        self.dihedral_deg = G["dihedral_deg"]

        # --- horizontal tail ---
        H = G["horizontal_tail"]
        self.V_ht = H["volume_coefficient"]
        self.L_ht = H["arm_ft"]
        self.AR_ht = H["AR"]
        self.taper_ht = H["taper_ratio"]
        self.tc_ht = H["thickness_ratio"]
        self.sweep_qc_ht_deg = H["sweep_quarter_chord_deg"]

        # --- vertical tail (same keys; written to the _vt names, not _ht) ---
        V = G["vertical_tail"]
        self.V_vt = V["volume_coefficient"]
        self.L_vt = V["arm_ft"]
        self.AR_vt = V["AR"]
        self.taper_vt = V["taper_ratio"]
        self.tc_vt = V["thickness_ratio"]
        self.sweep_qc_vt_deg = V["sweep_quarter_chord_deg"]

        # --- fuselage (all fixed) ---
        F = G["fuselage"]
        self.w_fus = F["width_ft"]
        self.h_fus = F["height_ft"]
        self.l_nose = F["nose_length_ft"]
        self.l_cabin = F["constant_length_ft"]
        self.l_cone = F["tailcone_length_ft"]
        self.w_cone_end = F["tailcone_end_width_ft"]
        self.h_cone_end = F["tailcone_end_height_ft"]

        # --- nacelle ---
        N = G["nacelle"]
        self.d_nacelle = N["diameter_ft"]
        self.k_nacelle_length = N["length_over_engine_length"]

        # --- landing gear geometry ---
        LG = G["landing_gear"]
        self.l_n_over_l_d = LG["l_n_over_l_d"]
        self.l_m_over_l_d = LG["l_m_over_l_d"]

    # ---------------- abstract interface ----------------
    def get_S_ref(self):
        return self.S_ref

    def get_S_wet(self, W_TO=None):
        return self.S_wet

    # ---------------- wing planform ----------------
    @property
    def b(self):
        return GeometryBase.compute_span(self.AR, self.S_ref)

    @property
    def c_root(self):
        return GeometryBase.compute_root_chord(self.S_ref, self.b, self.taper)

    @property
    def c_tip(self):
        return GeometryBase.compute_tip_chord(self.c_root, self.taper)

    @property
    def MAC(self):
        return GeometryBase.compute_mac(self.c_root, self.taper)

    @property
    def y_MAC(self):
        return TtpaGeom.compute_y_mac(self.b, self.taper)

    @property
    def tc_mean(self):
        return 0.5 * (self.tc_root + self.tc_tip)

    @property
    def S_exposed_wing(self):
        """Planform outside the fuselage [ft^2]: the reference trapezoid minus the
        strip buried in the fuselage, exact for a straight-tapered wing."""
        S_covered = self.c_root * self.w_fus * (1 - (1 - self.taper) * self.w_fus / (2 * self.b))
        return self.S_ref - S_covered

    # ---------------- horizontal tail ----------------
    @property
    def S_ht(self):
        """Volume-coefficient method, length scale MAC. [Raymer Eq. 6.29]"""
        return self.V_ht * self.S_ref * self.MAC / self.L_ht

    @property
    def b_ht(self):
        return GeometryBase.compute_span(self.AR_ht, self.S_ht)

    @property
    def c_root_ht(self):
        return GeometryBase.compute_root_chord(self.S_ht, self.b_ht, self.taper_ht)

    @property
    def c_tip_ht(self):
        return GeometryBase.compute_tip_chord(self.c_root_ht, self.taper_ht)

    @property
    def MAC_ht(self):
        return GeometryBase.compute_mac(self.c_root_ht, self.taper_ht)

    @property
    def y_MAC_ht(self):
        return TtpaGeom.compute_y_mac(self.b_ht, self.taper_ht)

    # ---------------- vertical tail ----------------
    @property
    def S_vt(self):
        """Volume-coefficient method, length scale SPAN (not MAC). [Raymer Eq. 6.28]"""
        return self.V_vt * self.S_ref * self.b / self.L_vt

    @property
    def b_vt(self):
        return GeometryBase.compute_span(self.AR_vt, self.S_vt)

    @property
    def c_root_vt(self):
        return GeometryBase.compute_root_chord(self.S_vt, self.b_vt, self.taper_vt)

    @property
    def c_tip_vt(self):
        return GeometryBase.compute_tip_chord(self.c_root_vt, self.taper_vt)

    @property
    def MAC_vt(self):
        return GeometryBase.compute_mac(self.c_root_vt, self.taper_vt)

    @property
    def y_MAC_vt(self):
        """Single panel, so the mirrored-surface result is doubled."""
        return 2 * TtpaGeom.compute_y_mac(self.b_vt, self.taper_vt)

    # ---------------- fuselage (constant through the loop) ----------------
    @property
    def l_fus(self):
        return self.l_nose + self.l_cabin + self.l_cone

    @property
    def fineness_ratio(self):
        return self.l_fus / max(self.w_fus, self.h_fus)

    @property
    def S_wet_fuselage(self):
        """[Raymer Eq. 7.13]  3.4 * (A_top + A_side) / 2. Depends on neither S_ref nor P_SL."""
        A_top = (0.5 * self.w_fus * self.l_nose + self.w_fus * self.l_cabin
                 + 0.5 * (self.w_fus + self.w_cone_end) * self.l_cone)
        A_side = (0.5 * self.h_fus * self.l_nose + self.h_fus * self.l_cabin
                  + 0.5 * (self.h_fus + self.h_cone_end) * self.l_cone)
        return 3.4 * (A_top + A_side) / 2

    # ---------------- nacelles (follow P_SL through prop) ----------------
    @property
    def l_engine(self):
        """Bare length of ONE engine [ft], from the propulsion model."""
        return self.prop.engine_length()

    @property
    def l_nacelle(self):
        """Length of ONE nacelle [ft]."""
        return self.k_nacelle_length * self.l_engine

    @property
    def S_wet_nacelle(self):
        """Wetted area of ALL nacelles [ft^2]: cylinder sides only (ends not wetted)."""
        return self.prop.n_engines * pi * self.d_nacelle * self.l_nacelle

    # ---------------- wetted areas ----------------
    @property
    def S_wet_wing(self):
        return TtpaGeom.wetted_from_exposed(self.S_exposed_wing, self.tc_mean)

    @property
    def S_wet_ht(self):
        return TtpaGeom.wetted_from_exposed(self.S_ht, self.tc_ht)

    @property
    def S_wet_vt(self):
        return TtpaGeom.wetted_from_exposed(self.S_vt, self.tc_vt)

    @property
    def S_wet(self):
        return (self.S_wet_wing + self.S_wet_ht + self.S_wet_vt
                + self.S_wet_fuselage + self.S_wet_nacelle)

    @property
    def S_wet_over_S_ref(self):
        """The one number the aero model needs to turn geometry into drag."""
        return self.S_wet / self.S_ref

    # ---------------- post-sizing check ----------------
    def wing_fuel_volume(self):
        """Usable wing fuel volume [ft^3]. Torenbeek: run AFTER the loop converges."""
        tau = self.tc_tip / self.tc_root
        return (0.54 * (self.S_ref ** 2 / self.b) * self.tc_root
                * (1 + self.taper * sqrt(tau) + self.taper ** 2 * tau) / (1 + self.taper) ** 2)

    # ---------------- statics ----------------
    @staticmethod
    def compute_y_mac(b, lam):
        """Spanwise station of the MAC [ft]: b (1 + 2 lambda) / (6 (1 + lambda))."""
        if not (b > 0 and lam >= 0):
            raise ValueError(f"compute_y_mac: bad inputs b={b}, lambda={lam}")
        return b * (1 + 2 * lam) / (6 * (1 + lam))

    @staticmethod
    def wetted_from_exposed(S_exposed, tc):
        """Lifting-surface wetted area [ft^2]. [Raymer Eqs. 7.11, 7.12]"""
        if tc < 0:
            raise ValueError(f"wetted_from_exposed: tc must be >= 0, got {tc}")
        if tc < 0.05:
            return 2.003 * S_exposed                    # Eq. 7.11
        return S_exposed * (1.977 + 0.52 * tc)          # Eq. 7.12